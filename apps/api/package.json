{
  "name": "@beikao/api",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "check": "tsc -p tsconfig.check.json --noEmit",
    "test": "node --import tsx --test tests/app.test.ts tests/config.test.ts tests/questions.test.ts tests/passwords.test.ts",
    "test:db": "node --env-file-if-exists=../../.env --import tsx --test tests/*.integration.test.ts",
    "start": "node dist/server.js",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "bootstrap": "node --env-file-if-exists=../../.env --import tsx src/bootstrap.ts",
    "reset-password": "node --env-file-if-exists=../../.env --import tsx src/reset-password.ts",
    "seed-demo": "node --env-file-if-exists=../../.env --import tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
