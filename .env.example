# Copy to .env. Generate a unique password before starting Compose.
POSTGRES_USER=beikao
POSTGRES_DB=beikao
POSTGRES_PASSWORD=
# Listen only on the server itself. Put your HTTPS reverse proxy in front.
HTTP_BIND=127.0.0.1
HTTP_PORT=43128
# Used by the local API process only; Compose builds its own internal URL.
# Percent-encode special characters in a DATABASE_URL password.
DATABASE_URL=postgresql://beikao:REPLACE_ME@127.0.0.1:5432/beikao
HOST=127.0.0.1
PORT=43127
WEB_DEV_PORT=43126
LOG_LEVEL=info
APP_ORIGIN=http://127.0.0.1:43128
# Set APP_ORIGIN to the real HTTPS origin, then set this to false for public use.
ALLOW_INSECURE_HTTP=true
# 1 for bundled Nginx only; 2 for a trusted host Caddy/Nginx plus bundled Nginx.
TRUST_PROXY_HOPS=1
SESSION_HOURS=168
